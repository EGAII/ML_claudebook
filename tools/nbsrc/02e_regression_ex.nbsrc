w_ex, b_ex = normal_equation(Xreg, yreg)
loss_ex = mse_loss(Xreg, yreg, w_ex, b_ex)

assert np.asarray(w_ex).shape == (2,), f'w shape {np.asarray(w_ex).shape}'
